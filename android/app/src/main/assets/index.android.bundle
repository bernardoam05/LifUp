ral_drake',name:'Drag\xe3o Astral',rank:'Marshal',type:'Ancient',passiveEffect:{type:'focus_mastery',value:.1,description:'-10% tempo de foco necess\xe1rio'},lore:'"Respira, ret\xe9m, medita. O fogo interior acorda sem queimar."',icon:'fire',color:'#f59e0b'}),s('boss_lich_king',{id:'quest_boss_lich_king',name:'Rei Lich Esquecido',rank:'Marshal',type:'Undead',passiveEffect:{type:'penalty_reduce',value:.18,description:'-18% na perda de XP por penalidade'},lore:'"Imobilidade total. S\xf3 a mente atravessa muros."',icon:'crown',color:'#a855f7'}),s('boss_tarantula',{id:'quest_boss_tarantula',name:'Tar\xe2ntula Imperial',rank:'Knight',type:'Insect',passiveEffect:{type:'loot_perception',value:.05,description:'+5% b\xf3nus em loot boxes'},lore:'"Cada passo medido. O labirinto obedece ao mapa interno."',icon:'spider',color:'#78716c'}),s('boss_fallen_monk',{id:'quest_boss_fallen_monk',name:'Monge Ca\xeddo',rank:'Knight',type:'Support',passiveEffect:{type:'focus_mastery',value:.08,description:'-8% tempo de foco necess\xe1rio'},lore:'"Um s\xf3 foco. Zero ru\xeddo."',icon:'meditation',color:'#a78bfa'}),s('boss_swamp_wraith',{id:'quest_boss_swamp_wraith',name:'Espectro do P\xe2ntano',rank:'Knight',type:'Ghost',passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Escreve o p\xe2ntano interior at\xe9 encontrar sa\xedda."',icon:'water-opacity',color:'#65a30d'}),s('boss_titan_ape',{id:'quest_boss_titan_ape',name:'Primata Tit\xe2nico',rank:'Commander',type:'Beast',passiveEffect:{type:'xp_boost',value:.11,description:'+11% XP em todas as miss\xf5es'},lore:'"Alterna for\xe7a bruta at\xe9 o ch\xe3o tremer de respeito."',icon:'ape',color:'#92400e'}),s('boss_astral_seer',{id:'quest_boss_astral_seer',name:'Or\xe1culo Astral',rank:'Knight',type:'Mage',passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"P\xe1ginas t\xe9cnicas como runas. Compreender \xe9 vencer."',icon:'crystal-ball',color:'#6366f1'}),s('boss_astral_hound',{id:'quest_boss_astral_hound',name:'C\xe3o C\xf3smico Errante',rank:'Knight',type:'Beast',passiveEffect:{type:'boss_bonus_xp',value:.08,description:'+8% XP extra em Boss Raids'},lore:'"Ritmo constante. O horizonte \xe9 linha de chegada."',icon:'dog-side',color:'#0ea5e9'}),s('boss_archlich_prime',{id:'quest_boss_archlich_prime',name:'Arquilich Primordial',rank:'Marshal',type:'Undead',passiveEffect:{type:'xp_boost',value:.16,description:'+16% XP em todas as miss\xf5es'},lore:'"Projeto com entreg\xe1vel. Magia \xe9 engenharia com prazo."',icon:'book-open-page-variant',color:'#c084fc'}),s('boss_soul_reaper',{id:'quest_boss_soul_reaper',name:'Ceifeiro de Almas',rank:'Marshal',type:'Undead',passiveEffect:{type:'xp_boost',value:.17,description:'+17% XP em todas as miss\xf5es'},lore:'"Trabalho criativo at\xe9 o fim. O vazio paga em cor."',icon:'skull-outline',color:'#7c3aed'}),s('boss_astral_nebula',{id:'quest_boss_astral_nebula',name:'Rei Nebulosa',rank:'Marshal',type:'Magic',passiveEffect:{type:'gold_boost',value:.12,description:'+12% Gold em todas as miss\xf5es'},lore:'"Marcha longa. Cada passo \xe9 constela\xe7\xe3o."',icon:'star-four-points',color:'#e879f9'}),s('boss_goblin_warlord',{id:'quest_boss_goblin_warlord',name:'Senhor Goblin Tabata',rank:'Knight',type:'Warrior',passiveEffect:{type:'xp_boost',value:.06,description:'+6% XP em todas as miss\xf5es'},lore:'"20s inferno, 10s purgat\xf3rio. Repete."',icon:'fire-alert',color:'#16a34a'}),s('boss_cave_spider_matriarch',{id:'quest_boss_cave_spider_matriarch',name:'Matriarca da Caverna',rank:'Knight',type:'Insect',passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Ensina como quem tece. Feynman \xe9 armadilha de ca\xe7a."',icon:'spider-web',color:'#57534e'}),s('boss_ant_worker_prime',{id:'quest_boss_ant_worker_prime',name:'Oper\xe1ria Primordial',rank:'Knight',type:'Insect',passiveEffect:{type:'loot_perception',value:.04,description:'+4% b\xf3nus em loot boxes'},lore:'"Explora sem mapa. Descobre tr\xeas verdades novas."',icon:'bug',color:'#ca8a04'}),s('boss_stone_golem_shard',{id:'quest_boss_stone_golem_shard',name:'Fragmento do Golem',rank:'Knight',type:'Tank',passiveEffect:{type:'xp_boost',value:.06,description:'+6% XP em todas as miss\xf5es'},lore:'"Corpo novo, movimento estranho. Domina no fim."',icon:'weight-lifter',color:'#78716c'}),s('boss_stringsinger',{id:'quest_boss_stringsinger',name:'Cantor das Cordas',rank:'Knight',type:'Artisan',passiveEffect:{type:'gold_boost',value:.06,description:'+6% Gold em todas as miss\xf5es'},lore:'"Metr\xf3nomo implac\xe1vel. Tr\xeas acordes, um imp\xe9rio."',icon:'guitar-acoustic',color:'#d97706'}),s('boss_polyglot_trial',{id:'quest_boss_polyglot_trial',name:'Poliglota da Prova\xe7\xe3o',rank:'Knight',type:'Explorer',passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Palavras novas, frases novas. O mundo encolhe."',icon:'translate',color:'#0d9488'}),s('boss_culinary_ritual',{id:'quest_boss_culinary_ritual',name:'Chef do Ritual',rank:'Knight',type:'Artisan',passiveEffect:{type:'gold_boost',value:.07,description:'+7% Gold em todas as miss\xf5es'},lore:'"Do zero ao prato. O fog\xe3o \xe9 forja."',icon:'pot-steam',color:'#ea580c'}),s('boss_memory_labyrinth',{id:'quest_boss_memory_labyrinth',name:'Curador do Pal\xe1cio Mental',rank:'Knight',type:'Mage',passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Doze \xe2ncoras na mem\xf3ria. Duas voltas completas."',icon:'brain',color:'#8b5cf6'}),s('boss_new_frontier',{id:'quest_boss_new_frontier',name:'Pioneiro da Fronteira',rank:'Knight',type:'Explorer',passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"Aula curta, notas longas. Novo \xe9 perigoso e necess\xe1rio."',icon:'terrain',color:'#059669'}),s('boss_artisan_trial',{id:'quest_boss_artisan_trial',name:'Artes\xe3o do Prot\xf3tipo',rank:'Knight',type:'Artisan',passiveEffect:{type:'gold_boost',value:.08,description:'+8% Gold em todas as miss\xf5es'},lore:'"Objeto \xfatil. Erro vira li\xe7\xe3o s\xf3lida."',icon:'hammer-wrench',color:'#b45309'}),s('boss_storm_bringer',{id:'quest_boss_storm_bringer',name:'Invocador de Tempestades',rank:'Marshal',type:'Elemental',passiveEffect:{type:'xp_boost',value:.16,description:'+16% XP em todas as miss\xf5es'},lore:'"Uma skill, um sprint. A tempestade tem nome."',icon:'weather-lightning',color:'#facc15'}),s('boss_chrono_master',{id:'quest_boss_chrono_master',name:'Senhor do Tempo',rank:'Marshal',type:'Ancient',passiveEffect:{type:'focus_mastery',value:.14,description:'-14% tempo de foco necess\xe1rio'},lore:'"Cinco blocos. Tr\xeas vit\xf3rias. O rel\xf3gio aplaude."',icon:'clock-outline',color:'#fcd34d'}),s('boss_star_breaker',{id:'quest_boss_star_breaker',name:'Quebrador de Estrelas',rank:'Marshal',type:'Explorer',passiveEffect:{type:'loot_perception',value:.08,description:'+8% b\xf3nus em loot boxes'},lore:'"Km novos, olhos novos. O mapa rasga-se sozinho."',icon:'star-four-points',color:'#f472b6'}),s('boss_cold_philosopher',{id:'quest_boss_cold_philosopher',name:'Fil\xf3sofo da Montanha',rank:'Knight',type:'Mage',passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Problema real, opini\xf5es opostas. Decis\xe3o escrita no fim."',icon:'head-cog',color:'#64748b'}),s('boss_digital_craftsman',{id:'quest_boss_digital_craftsman',name:'Artes\xe3o Digital',rank:'Knight',type:'Artisan',passiveEffect:{type:'gold_boost',value:.08,description:'+8% Gold em todas as miss\xf5es'},lore:'"Build que compila. Demo que impressiona."',icon:'code-braces',color:'#22d3ee'}),s('boss_stoic_challenge',{id:'quest_boss_stoic_challenge',name:'Estoico do Desconforto',rank:'Knight',type:'Warrior',passiveEffect:{type:'penalty_reduce',value:.08,description:'-8% na perda de XP por penalidade'},lore:'"Frio real, corpo honesto. Antes e depois contam a hist\xf3ria."',icon:'snowflake-alert',color:'#94a3b8'})]},504,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SHADOWS_BOSS_DUNGEON_BREAK=void 0;e.SHADOWS_BOSS_DUNGEON_BREAK=[{id:'moss_golem',name:'Golem de Musgo',rank:'Normal',type:'Tank',dropRate:.09,dropChance:.4,passiveEffect:{type:'daily_bonus',value:3,description:'+3 XP gr\xe1tis ao iniciar cada dia'},lore:'"Constru\xeddo pelos druidas de uma era h\xe1 muito esquecida. Lento mas imortal \u2014 cada dia que passa, mais musgo cresce. Mais for\xe7a acumula."',icon:'tree',color:'#94a3b8',unlockMethod:{type:'boss_drop',bossId:'break_boss_lich_servant_vanguard',category:'dungeon_break'}},{id:'tunnel_mole',name:'Toupeira do Abismo',rank:'Normal',type:'Beast',dropRate:.1,dropChance:.4,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Escavou durante mil\xe9nios, sempre em dire\xe7\xe3o a algo que n\xe3o sabia nomear. Encontrou o Monarca. A escava\xe7\xe3o faz sentido agora."',icon:'circle',color:'#94a3b8',unlockMethod:{type:'boss_drop',bossId:'break_boss_giant_worm_abyss',category:'dungeon_break'}},{id:'frost_sprite',name:'Sprite de Gelo',rank:'Normal',type:'Elemental',dropRate:.09,dropChance:.4,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Nasceu na primeira geada de um dungeon \xe1rtico. Pequeno como um floco de neve, frio como o esquecimento."',icon:'snowflake-variant',color:'#94a3b8',unlockMethod:{type:'boss_drop',bossId:'break_boss_dark_knight_traitor',category:'dungeon_break'}},{id:'dusk_jackal',name:'Chacal do Crep\xfasculo',rank:'Normal',type:'Beast',dropRate:.1,dropChance:.4,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Esperava nos corredores dos dungeons de deserto, onde o calor mata mais ca\xe7adores do que os monstros. A paci\xeancia \xe9 o seu dom."',icon:'paw',color:'#94a3b8',unlockMethod:{type:'boss_drop',bossId:'break_boss_succubus_scout_night',category:'dungeon_break'}},{id:'bone_shielder',name:'Escudeiro de Osso',rank:'Normal',type:'Undead',dropRate:.08,dropChance:.4,passiveEffect:{type:'penalty_reduce',value:.02,description:'-2% na perda de XP por penalidade'},lore:'"Em vida, protegeu cavaleiros. Na morte, protege o Monarca. A fun\xe7\xe3o mudou; a dedica\xe7\xe3o, n\xe3o."',icon:'shield-outline',color:'#94a3b8',unlockMethod:{type:'boss_drop',bossId:'break_boss_gargoyle_watcher_stone',category:'dungeon_break'}},{id:'shadow_lich_vanguard',name:'Vanguarda do Lich',rank:'Elite',type:'Undead',dropRate:0,dropChance:.35,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Dava a vida pelo seu mestre. Na morte, encontrou um mestre que n\xe3o pode morrer."',icon:'skull-outline',color:'#22c55e',unlockMethod:{type:'boss_drop',bossId:'break_boss_lich_servant_vanguard',category:'dungeon_break'}},{id:'shadow_giant_worm',name:'Verme do Abismo Sombrio',rank:'Elite',type:'Beast',dropRate:0,dropChance:.35,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"O que devorava montanhas agora devora as tuas dificuldades."',icon:'caterpillar',color:'#22c55e',unlockMethod:{type:'boss_drop',bossId:'break_boss_giant_worm_abyss',category:'dungeon_break'}},{id:'shadow_dark_knight_traitor',name:'Assassino Sombrio Ca\xeddo',rank:'Elite',type:'Assassin',dropRate:0,dropChance:.35,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Traiu o seu reino por poder. Na sombra, encontrou o poder que procurava."',icon:'sword-cross',color:'#22c55e',unlockMethod:{type:'boss_drop',bossId:'break_boss_dark_knight_traitor',category:'dungeon_break'}},{id:'shadow_succubus_scout',name:'Sentinela do Desejo',rank:'Knight',type:'Demon',dropRate:0,dropChance:.25,passiveEffect:{type:'gold_boost',value:.1,description:'+10% Gold em todas as miss\xf5es'},lore:'"Seduz os tesouros para fora dos seus esconderijos. Uma aliada valiosa para a tua fortuna."',icon:'heart-broken',color:'#3b8