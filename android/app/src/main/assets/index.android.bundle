__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SHADOWS_BOSS_EVENT=void 0;e.SHADOWS_BOSS_EVENT=[{id:'easter_hare_shadow',name:'Coelho das Sombras',rank:'Knight',type:'Beast',dropRate:.1,passiveEffect:{type:'xp_boost',value:.06,description:'+6% XP em todas as miss\xf5es'},lore:'"Saltava entre os portais com agilidade sobrenatural. O Monarca venceu-o na sua pr\xf3pria corrida \u2014 e reclamou-o como sombra."',icon:'rabbit',color:'#3b82f6',unlockMethod:{type:'boss_drop',bossId:'event_easter_hare',category:'event'}},{id:'mud_elemental',name:'Elemental de Lama',rank:'Knight',type:'Elemental',dropRate:.1,passiveEffect:{type:'daily_bonus',value:10,description:'+10 XP gr\xe1tis ao iniciar cada dia'},lore:'"Nasceu da \xe1gua e da terra do dungeon submerso. Agora carrega o peso do Monarca com sil\xeancio e const\xe2ncia."',icon:'water',color:'#3b82f6',unlockMethod:{type:'boss_drop',bossId:'event_spring_bloom',category:'event'}},{id:'archlich_prime',name:'Arqui-Lich Supremo',rank:'Marshal',type:'Undead',dropRate:.025,passiveEffect:{type:'xp_boost',value:.25,description:'+25% XP em todas as miss\xf5es'},lore:'"Sacrificou a sua alma por imortalidade. Obteve-a. Passou mil\xe9nios a acumular poder nos dungeons mais profundos. O Monarca reclamou tudo isso em sete minutos."',icon:'coffin',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_winter_lich',category:'event'}},{id:'auto_titan',name:'Tit\xe3 de Sucata',rank:'Marshal',type:'Tank',dropRate:.05,passiveEffect:{type:'gold_boost',value:.25,description:'+25% Gold em todas as miss\xf5es'},lore:'"Nasceu da fus\xe3o de centenas de aut\xf3matos quebrados. Uma montanha de metal que segue o Monarca de forma desajeitada mas letal."',icon:'train-car',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_summer_titan',category:'event'}},{id:'auto_omega',name:'Arma \xd3mega',rank:'Marshal',type:'Warrior',dropRate:.02,passiveEffect:{type:'boss_bonus_xp',value:.25,description:'+25% XP extra em Boss Raids'},lore:'"A \xfaltima linha de defesa dos velhos construtores. O Monarca desativou-a com for\xe7a bruta. Agora, a aniquila\xe7\xe3o tem um novo mestre."',icon:'nuke',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_black_friday_merchant',category:'event'}},{id:'astral_wisp',name:'Luz Estelar Moribunda',rank:'Knight',type:'Elemental',dropRate:.1,passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"Uma fa\xedsca de uma gal\xe1xia morta, recolhida do v\xf3rtice astral. D\xe1 calor silencioso."',icon:'star-outline',color:'#3b82f6',unlockMethod:{type:'boss_drop',bossId:'event_valentine_oath',category:'event'}},{id:'astral_echo',name:'Eco do Cometa',rank:'Knight',type:'Magic',dropRate:.1,passiveEffect:{type:'focus_mastery',value:.1,description:'-10% tempo de foco necess\xe1rio'},lore:'"O som residual de um impacto estelar que durou um mil\xe9nio. Acalma a mente mortal."',icon:'star-shooting',color:'#3b82f6',unlockMethod:{type:'boss_drop',bossId:'event_carnival_mask',category:'event'}},{id:'astral_guardian',name:'Vigia Orbital',rank:'Marshal',type:'Tank',dropRate:.08,passiveEffect:{type:'gold_boost',value:.2,description:'+20% Gold em todas as miss\xf5es'},lore:'"Peda\xe7os gravitacionais de meteoritos servem como a sua armadura girat\xf3ria. Um sat\xe9lite de defesa perfeito."',icon:'earth',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_equinox_guardian',category:'event'}},{id:'god_seraphim',name:'L\xe2mina Serafim Ca\xeddo',rank:'Marshal',type:'Assassin',dropRate:.02,passiveEffect:{type:'xp_boost',value:.3,description:'+30% XP em todas as miss\xf5es'},lore:'"Seis asas decepadas transmutadas em tend\xe3o escuro. Onde passava trazia luz cega. Onde vai, s\xf3 cai sombra espessa e letal."',icon:'sword',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_yule_seraph',category:'event'}},{id:'shadow_dragon',name:'Filhote de Drag\xe3o Sombrio',rank:'Marshal',type:'Beast',dropRate:.02,passiveEffect:{type:'boss_bonus_xp',value:.3,description:'+30% XP extra em Boss Raids'},lore:'"Um p\xe1lido eco do poder drac\xf3nico, mas cresce dia ap\xf3s dia no ex\xe9rcito real do Monarca."',icon:'dinosaur',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_festival_drake',category:'event'}},{id:'hollow_peasant',name:'Alde\xe3o Vazio',rank:'Commander',type:'Undead',dropRate:.1,passiveEffect:{type:'gold_boost',value:.12,description:'+12% Gold em todas as miss\xf5es'},lore:'"Nunca segurou uma arma na vida. Na morte, o seu medo desapareceu."',icon:'pitchfork',color:'#f59e0b',unlockMethod:{type:'boss_drop',bossId:'event_harvest_king',category:'event'}},{id:'ash_specter',name:'Espectro de Cinzas',rank:'Commander',type:'Magic',dropRate:.1,passiveEffect:{type:'penalty_reduce',value:.15,description:'-15% na perda de XP por penalidade'},lore:'"Nasceu das fogueiras de acampamentos de ca\xe7adores aniquilados."',icon:'fire',color:'#f59e0b',unlockMethod:{type:'boss_drop',bossId:'event_new_year_ashen',category:'event'}},{id:'soul_reaper',name:'Ceifeiro de Almas',rank:'Marshal',type:'Undead',dropRate:.02,passiveEffect:{type:'focus_mastery',value:.3,description:'-30% tempo de foco necess\xe1rio'},lore:'"Rivalizava os Guias do Submundo. O Monarca usurpou a sua posi\xe7\xe3o numa \xfanica batalha."',icon:'sickle',color:'#ef4444',unlockMethod:{type:'boss_drop',bossId:'event_halloween_reaper',category:'event'}},{id:'midnight_specter',name:'Espectro da Meia-Noite',rank:'Commander',type:'Undead',dropRate:.04,passiveEffect:{type:'focus_mastery',value:.18,description:'-18% tempo de foco necess\xe1rio'},lore:'"S\xf3 emerge depois da meia-noite, quando o v\xe9u entre os mundos se afina ao m\xe1ximo. O Monarca que ca\xe7a \xe0 luz da lua \xe9 o \xfanico digno de a comandar."',icon:'weather-night',color:'#f59e0b',unlockMethod:{type:'boss_drop',bossId:'event_midnight_wraith',category:'event'}}]},506,[]);
