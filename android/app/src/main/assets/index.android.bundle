__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SHADOWS_GACHA=void 0;e.SHADOWS_GACHA=[{id:'swamp_troll',name:'Troll do P\xe2ntano',rank:'Elite',type:'Tank',dropRate:.09,passiveEffect:{type:'daily_bonus',value:5,description:'+5 XP gr\xe1tis ao iniciar cada dia'},lore:'"Regenerava qualquer ferida. N\xe3o havia arma que o pudesse matar permanentemente \u2014 at\xe9 ao dia em que o Monarca o tentou. E conseguiu."',icon:'emoticon-devil',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'fire_salamander',name:'Salamandra de Fogo',rank:'Elite',type:'Elemental',dropRate:.09,passiveEffect:{type:'gold_boost',value:.02,description:'+2% Gold em todas as miss\xf5es'},lore:'"Vivia nos lagos de lava dos dungeons vulc\xe2nicos. As suas escamas eram mais valiosas que ouro. Agora serve um mestre mais valioso ainda."',icon:'fire-circle',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'ember_wolf',name:'Lobo das Brasas',rank:'Elite',type:'Beast',dropRate:.09,passiveEffect:{type:'gold_boost',value:.02,description:'+2% Gold em todas as miss\xf5es'},lore:'"A sua pele ardia. A sua alcateia morreu no calor do dungeon. Ele sobreviveu sozinho porque o fogo n\xe3o queimava o que j\xe1 era chama."',icon:'fire-alert',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'grizzly_shadow',name:'Urso Cinzento das Sombras',rank:'Knight',type:'Beast',dropRate:.1,passiveEffect:{type:'gold_boost',value:.04,description:'+4% Gold em todas as miss\xf5es'},lore:'"Rei das florestas antes do dungeon se abrir. Rei das sombras depois. A hierarquia muda, mas a realeza permanece."',icon:'paw',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'armored_knight',name:'Cavaleiro Blindado',rank:'Knight',type:'Warrior',dropRate:.09,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Jurou proteger o seu rei at\xe9 \xe0 morte. A morte chegou. O juramento n\xe3o."',icon:'shield-sword',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'ant_queen_guard',name:'Guarda da Rainha Formiga',rank:'Knight',type:'Insect',dropRate:.09,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"A rainha caiu. O guarda permaneceu. Sem rei, sem rainha \u2014 apenas o dever de proteger algo maior que si mesmo."',icon:'bug-check',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'storm_witch',name:'Bruxa das Tempestades',rank:'Knight',type:'Magic',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.1,description:'+10% XP extra em Boss Raids'},lore:'"Invocou rel\xe2mpagos que partiam montanhas. Mesmo convertida em sombra, o trov\xe3o que a acompanha pode ser ouvido."',icon:'lightning-bolt',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'vampire_lord',name:'Lorde Vampiro',rank:'Knight',type:'Undead',dropRate:.08,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"Viveu mil anos a roubar a vitalidade dos outros. Agora doa a sua para alimentar o poder do Monarca."',icon:'bat',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'flying_ant_elite',name:'Formiga Voadora de Elite',rank:'Knight',type:'Insect',dropRate:.08,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"A unidade de reconhecimento a\xe9reo da col\xf3nia. Nenhum Hunter alguma vez a viu a tempo de reagir."',icon:'bee',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'stone_giant',name:'Gigante de Pedra',rank:'Knight',type:'Tank',dropRate:.08,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"Altura equivalente a um edif\xedcio de cinco andares. For\xe7a equivalente a uma cat\xe1strofe natural. Lealdade equivalente a uma rocha."',icon:'pine-tree',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'phantom_assassin',name:'Assassino Fantasma',rank:'Knight',type:'Assassin',dropRate:.07,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"N\xe3o existe nos registos de nenhum dungeon. Nenhuma testemunha sobreviveu para confirmar a sua presen\xe7a."',icon:'incognito',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'wendigo',name:'Wendigo das Altitudes',rank:'Knight',type:'Beast',dropRate:.08,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"A fome que o consumia em vida nunca cessou. Na morte, essa fome converteu-se em vontade \u2014 e a vontade serve o Monarca."',icon:'skull-crossbones',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'fallen_paladin',name:'Paladino Ca\xeddo',rank:'Knight',type:'Warrior',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.07,description:'-7% na perda de XP por penalidade'},lore:'"A sua f\xe9 foi tra\xedda pelo deus que serviu. Caiu n\xe3o por fraqueza, mas por ilus\xe3o. O Monarca n\xe3o lhe prometeu para\xedso \u2014 prometeu prop\xf3sito."',icon:'church',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'ogre_warchief',name:'Chefe de Guerra Ogre',rank:'Knight',type:'Tank',dropRate:.07,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"Liderava hordas inteiras de criaturas cavernosas. A sua t\xe1tica era simples: avan\xe7ar. E funcionava. Na morte, ainda avan\xe7a."',icon:'weight-lifter',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'dark_elemental_spirit',name:'Esp\xedrito Elemental Negro',rank:'Knight',type:'Elemental',dropRate:.07,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Formado pela fus\xe3o de todos os elementos corrompidos. N\xe3o obedecia a nenhum mestre \u2014 at\xe9 encontrar um que era mais escuro que ele pr\xf3prio."',icon:'weather-night',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'banshee',name:'Banshee das Profundezas',rank:'Knight',type:'Undead',dropRate:.07,passiveEffect:{type:'daily_bonus',value:10,description:'+10 XP gr\xe1tis ao iniciar cada dia'},lore:'"O seu grito era uma profecia de morte. Cada manh\xe3, a sua voz anuncia o in\xedcio de um novo dia de poder para o Monarca."',icon:'account-voice',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'manticore',name:'Manticora Sombria',rank:'Knight',type:'Beast',dropRate:.07,passiveEffect:{type:'boss_bonus_xp',value:.08,description:'+8% XP extra em Boss Raids'},lore:'"Corpo de le\xe3o, asas de raptor, cauda venenosa. Era a criatura mais temida de tr\xeas dungeons. O Monarca levou dez minutos a subjug\xe1-la."',icon:'cat',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'frost_giant_warrior',name:'Guerreiro Gigante de Gelo',rank:'Knight',type:'Tank',dropRate:.07,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"Os cl\xe3s do norte temiam o seu nome. Cada inverno que passava, tornava-se mais forte. Mesmo na morte, o frio que emanava nunca fundiu."',icon:'snowman',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'drow_warlord',name:'Senhor da Guerra Drow',rank:'Knight',type:'Warrior',dropRate:.07,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Comandou ex\xe9rcitos subterr\xe2neos durante tr\xeas reinados. Conhecia cada t\xfanel, cada armadilha. O Monarca aprendeu-os todos \u2014 e ent\xe3o conquistou o general."',icon:'sword',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'crypt_guardian',name:'Guardi\xe3o da Cripta',rank:'Knight',type:'Undead',dropRate:.07,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Guarda os t\xfamulos dos antigos Ca\xe7adores. Conhece cada l\xe1pide, cada nome. Agora guarda o \xfanico ca\xe7ador que n\xe3o precisa de l\xe1pide."',icon:'grave-stone',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'crimson_knight',name:'Cavaleiro Carmesim',rank:'Commander',type:'Warrior',dropRate:.04,passiveEffect:{type:'xp_boost',value:.1,description:'+10% XP em todas as miss\xf5es'},lore:'"O mais fiel dos cavaleiros das sombras. Mesmo na morte, a sua armadura mant\xe9m o brilho carmesim. Nenhuma ordem \xe9 recusada."',icon:'sword-cross',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'tank',name:'Tank, o Gorila das Sombras',rank:'Commander',type:'Beast',dropRate:.04,passiveEffect:{type:'penalty_reduce',value:.1,description:'-10% na perda de XP por penalidade'},lore:'"A primeira sombra que o Monarca recolheu de um Boss Raid. N\xe3o \xe9 o mais inteligente, mas nenhuma barreira resiste ao seu peso."',icon:'ape',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'iron',name:'Iron, o Pugilista',rank:'Commander',type:'Warrior',dropRate:.04,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold e +5% XP em treinos f\xedsicos'},lore:'"Campe\xe3o de combate corpo a corpo em vida. Na morte, os seus punhos tornaram-se instrumentos do Monarca \u2014 e nunca erram."',icon:'boxing-glove',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'serpent_sovereign',name:'Soberano Serpente',rank:'Commander',type:'Beast',dropRate:.03,passiveEffect:{type:'boss_bonus_xp',value:.15,description:'+15% XP extra em Boss Raids'},lore:'"Governou o seu pantanal com veneno e paci\xeancia. Esperou s\xe9culos pelo desafiante certo. Quando chegou, perdeu. E passou a seguir."',icon:'snake',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'tusk',name:'Tusk, o Rei Javali',rank:'Commander',type:'Beast',dropRate:.03,passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"Uma carga do Tusk partia forma\xe7\xf5es inteiras de ca\xe7adores. Agora essa carga est\xe1 direcionada para os inimigos do Monarca."',icon:'elephant',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'cerberus',name:'Cerberus, o Guardi\xe3o',rank:'Commander',type:'Beast',dropRate:.03,passiveEffect:{type:'streak_protect',value:2,description:'Protege o streak duas vezes por semana'},lore:'"Tr\xeas cabe\xe7as, tr\xeas mentes, um \xfanico prop\xf3sito. Nenhum ca\xe7ador passou o portal que ele guardava. O Monarca foi o primeiro."',icon:'dog',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'void_warlord',name:'Senhor de Guerra do Vazio',rank:'Commander',type:'Demon',dropRate:.035,passiveEffect:{type:'xp_boost',value:.12,description:'+12% XP em todas as miss\xf5es'},lore:'"Dizem que dominou dungeons inteiros por pura crueldade. Esse poder agora \xe9 canalizado para o crescimento implac\xe1vel do Monarca."',icon:'skull',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'white_tiger_lord',name:'Lorde Tigre Branco',rank:'Commander',type:'Beast',dropRate:.03,passiveEffect:{type:'gold_boost',value:.08,description:'+8% Gold em todas as miss\xf5es'},lore:'"Um tigre albino sagrado do dungeon das montanhas nevadas. As tribos locais oravam para ele. O Monarca combateu-o durante tr\xeas dias. Ambos sobreviveram. Apenas um continua de p\xe9."',icon:'cat',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'iron_demon_lord',name:'Lorde Dem\xf4nio de Ferro',rank:'Commander',type:'Demon',dropRate:.025,passiveEffect:{type:'gold_boost',value:.1,description:'+10% Gold em todas as miss\xf5es'},lore:'"A sua pele era mais dura que qualquer metal forjado. Mil espadas se quebraram nela. Agora essa dureza protege a riqueza do Monarca."',icon:'account-hard-hat',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'wraith_commander',name:'Comandante Espectral',rank:'Commander',type:'Undead',dropRate:.025,passiveEffect:{type:'streak_protect',value:2,description:'Protege o streak duas vezes por semana'},lore:'"Liderou ex\xe9rcitos de mortos-vivos atrav\xe9s de sete dungeons sem nunca perder um \xfanico soldado \u2014 porque os mortos n\xe3o podem ser mortos duas vezes. A streak tamb\xe9m n\xe3o."',icon:'flag-variant',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'storm_herald',name:'Arauto da Tempestade',rank:'Commander',type:'Elemental',dropRate:.025,passiveEffect:{type:'boss_bonus_xp',value:.1,description:'+10% XP extra em Boss Raids'},lore:'"Anunciava as tempestades antes de chegarem. As criaturas do dungeon fugiam ao ouvir o seu grito. O Monarca ouviu e avan\xe7ou. O Arauto decidiu seguir quem n\xe3o fugia."',icon:'weather-lightning-rainy',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'swarm_lord',name:'Soberano do Enxame',rank:'Marshal',type:'Insect',dropRate:.01,passiveEffect:{type:'penalty_immunity',value:1,description:'Imunidade completa a 1 penalidade por semana'},lore:'"Governa a maior col\xf3nia de dungeons j\xe1 registada. Cem mil unidades respondem ao seu chamado. Agora responde ao chamado do Monarca \u2014 e a devo\xe7\xe3o n\xe3o mudou em escala."',icon:'crown',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'grand_marshal_prime',name:'Grande Marechal Primordial',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'arise_resonance',value:.05,description:'+5% chance extra de Arise (Shadow Extraction)'},lore:'"Existia antes dos dungeons. Viu imp\xe9rios nascer e colapsar. Apenas o Monarca alguma vez o subjugou. Considera-te aben\xe7oado."',icon:'star-four-points',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'greed',name:'Greed, o Espectro da Cobi\xe7a',rank:'Marshal',type:'Demon',dropRate:.005,passiveEffect:{type:'shop_discount',value:.15,description:'-15% no custo de todos os itens da Loja'},lore:'"Acumulou riqueza suficiente para comprar na\xe7\xf5es. Morreu sem gastar um \xfanico moeda. Agora serve o Monarca com ironia \u2014 pois o ouro que protegeu em vida, flui para o tesouro de outro."',icon:'cash-multiple',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'high_shadow',name:'Alta Sombra',rank:'Marshal',type:'Ancient',dropRate:.002,passiveEffect:{type:'penalty_immunity',value:1,description:'Imunidade completa a 1 penalidade por semana'},lore:'"N\xe3o tem nome. N\xe3o tem hist\xf3ria. N\xe3o tem origem conhecida. Apenas existe, nas margens de tudo que \xe9 escuro. Quem a obt\xe9m, obteve algo que o pr\xf3prio Sistema n\xe3o esperava revelar."',icon:'weather-night',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'auto_pawn',name:'Pe\xe3o Mec\xe2nico',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"A forma mais simples de aut\xf3mato da cripta, desenhado apenas para marchar em frente. Agora marcha para o Monarca."',icon:'robot',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_gear',name:'Engrenagem Viva',rank:'Normal',type:'Warrior',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Desligado h\xe1 mil\xe9nios, o seu n\xfacleo ativou-se com a presen\xe7a do Monarca."',icon:'cog-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_scout',name:'Sentinela Batedor',rank:'Normal',type:'Assassin',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Pequeno e r\xe1pido, um aut\xf3mato que vigiava os corredores labir\xednticos dos criadores mortos."',icon:'eye-circle-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_rust',name:'Guarda Enferrujado',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'penalty_reduce',value:.02,description:'-2% na perda de XP por penalidade'},lore:'"As lamelas de ferro descamam, mas a sua programa\xe7\xe3o primordial de defender n\xe3o expira."',icon:'shield-off-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_miner',name:'Escavador de Lat\xe3o',rank:'Normal',type:'Warrior',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Extra\xeda min\xe9rio magi-condutor. Agora extrai ouro para as arcas do Monarca."',icon:'pickaxe',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_welder',name:'Maquinista Cobre',rank:'Normal',type:'Magic',dropRate:.1,passiveEffect:{type:'focus_mastery',value:.05,description:'-5% tempo de foco necess\xe1rio'},lore:'"Concebido para reparar os outros aut\xf3matos. As suas fa\xedscas azuis iluminam o caminho sombrio."',icon:'flash-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'auto_clockwork',name:'Aut\xf3mato Rel\xf3gio',rank:'Elite',type:'Assassin',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"Move-se com a precis\xe3o de um ponteiro. Cada golpe \xe9 perfeitamente cronometrado."',icon:'clock-fast',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'auto_templar',name:'Templ\xe1rio Met\xe1lico',rank:'Elite',type:'Tank',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.04,description:'-4% na perda de XP por penalidade'},lore:'"Armadura maci\xe7a e escudo acoplado. N\xe3o sente dor. N\xe3o sente medo. Protege o mestre."',icon:'shield-star',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'auto_blade',name:'L\xe2mina Dentada',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Um aut\xf3mato com espadas girat\xf3rias em vez de bra\xe7os. Um terror nos corredores apertados da Cripta."',icon:'saw-blade',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'auto_cannon',name:'Torreta M\xf3vel',rank:'Elite',type:'Magic',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"Dispara energia m\xe1gica concentrada. Lento, mas de um poder destrutivo incompar\xe1vel na sua categoria."',icon:'car-cog',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'auto_spider',name:'Aracn\xeddeo Mec\xe2nico',rank:'Elite',type:'Beast',dropRate:.08,passiveEffect:{type:'daily_bonus',value:5,description:'+5 XP gr\xe1tis ao iniciar cada dia'},lore:'"Escala qualquer superf\xedcie, usando cabos de a\xe7o endurecido para apanhar presas biol\xf3gicas."',icon:'spider-thread',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'auto_centurion',name:'Centuri\xe3o da Cripta',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"A unidade de comando das patrulhas rob\xf3ticas. O seu chip central foi gravado com magias obscuras."',icon:'robot-industrial',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'auto_aegis',name:'\xc9gide de Tungst\xe9nio',rank:'Knight',type:'Tank',dropRate:.06,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Constru\xeddo para suportar explos\xf5es vulc\xe2nicas. O Monarca usou-o como barreira impenetr\xe1vel contra os falsos deuses."',icon:'shield-cross-outline',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'auto_specter',name:'Espectro de Fios',rank:'Knight',type:'Assassin',dropRate:.05,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Usa tecnologia de refra\xe7\xe3o de luz. Fica perfeitamente invis\xedvel antes de desferir cortes microsc\xf3picos."',icon:'ghost-off',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'auto_symphony',name:'Orquestrador B\xe9lico',rank:'Commander',type:'Magic',dropRate:.02,passiveEffect:{type:'focus_mastery',value:.15,description:'-15% tempo de foco necess\xe1rio'},lore:'"Controlava toda a infraestrutura da Cripta. Com as suas frequ\xeancias hipn\xf3ticas, o foco e o ritmo mental tornam-se inquebr\xe1veis."',icon:'music-clef-treble',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'auto_prime',name:'Prime, O Motor Eterno',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'shop_discount',value:.15,description:'-15% no custo de todos os itens da Loja'},lore:'"A primeira m\xe1quina da Cripta. Funciona atrav\xe9s de energia sombria pura. Em sua presen\xe7a, o Sistema reorganiza as prioridades log\xedsticas e comerciais."',icon:'engine-outline',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'astral_moth',name:'Mariposa do V\xe1cuo',rank:'Normal',type:'Insect',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Atra\xedda n\xe3o pelo calor, mas pela energia umbrosa do Monarca. Flutua entre dimens\xf5es."',icon:'butterfly',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'astral_hound',name:'C\xe3o C\xf3smico',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Fareja rastos n\xe3o na terra, mas nos tecidos do espa\xe7o. Encontra caminhos que n\xe3o deveriam existir."',icon:'dog',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'astral_phantom',name:'Manto das Pl\xeaiades',rank:'Elite',type:'Assassin',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"Uma sombra envolta no brilho azul das estrelas jovens. R\xe1pida e impiedosa, corta num clar\xe3o."',icon:'moon-waning-crescent',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'astral_weaver',name:'Tecel\xe3 de Constela\xe7\xf5es',rank:'Elite',type:'Magic',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.04,description:'-4% na perda de XP por penalidade'},lore:'"Poder capaz de ligar estrelas. Agora liga e fortifica os fragmentos m\xe1gicos do Monarca."',icon:'star-four-points',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'astral_striker',name:'Meteoro Laminado',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"A for\xe7a de impacto que causaria crateras em mundos inteiros, contida na l\xe2mina deste guerreiro ca\xeddo."',icon:'sword-cross',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'astral_behemoth',name:'Leviat\xe3 do V\xe1cuo',rank:'Knight',type:'Beast',dropRate:.06,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"Nadava pelos oceanos das nebulosas Escuras. Um tit\xe3 que corrompe o pr\xf3prio espa\xe7o onde pisa."',icon:'weather-night-partly-cloudy',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'astral_archon',name:'Arconte Solar',rank:'Knight',type:'Elemental',dropRate:.06,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Um ser infundido com o poder plasm\xe1tico de estrelas ativas. Cada golpe \xe9 uma explos\xe3o nuclear controlada."',icon:'white-balance-sunny',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'astral_seer',name:'Or\xe1culo da N\xe9voa',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'focus_mastery',value:.1,description:'-10% tempo de foco necess\xe1rio'},lore:'"Lia o futuro no colapso de Supernovas. Ao seu lado, o foco torna-se uma clarivid\xeancia afiada."',icon:'crystal-ball',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'astral_drifter',name:'N\xf3mada Intergal\xe1tico',rank:'Knight',type:'Assassin',dropRate:.06,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"Conhece mil mundos e os seus tesouros. Encontra vulnerabilidades que nenhum ser terrestre veria."',icon:'alien-outline',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'astral_nebula',name:'Rei Nebulosa',rank:'Commander',type:'Magic',dropRate:.02,passiveEffect:{type:'penalty_immunity',value:1,description:'Imunidade completa a 1 penalidade por semana'},lore:'"Nasceu do colapso e da forma\xe7\xe3o. Ao absorver falhas do Sistema, converte-as em pura energia vazia. Inegavelmente monstruoso."',icon:'weather-cloudy',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'astral_nova',name:'General Supernova',rank:'Commander',type:'Warrior',dropRate:.02,passiveEffect:{type:'boss_bonus_xp',value:.15,description:'+15% XP extra em Boss Raids'},lore:'"A f\xfaria de uma estrela que agoniza antes de deflagrar. Os bosses inimigos derretem face ao seu avan\xe7ar cintilante."',icon:'star-shooting',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'astral_eclipse',name:'Eclipse, a Fome C\xf3smica',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'xp_boost',value:.2,description:'+20% XP em todas as miss\xf5es'},lore:'"A escurid\xe3o que engole a luz de cem gal\xe1xias. Foi preciso o poder integral de um Autarca e o Monarca para o subjugar."',icon:'moon-new',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'glad_recruit',name:'Recruta da Arena',rank:'Normal',type:'Warrior',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Lutou com paus, sangrou na areia, morreu por aplausos vazios. O Monarca oferece-lhe uma arena eterna."',icon:'account-plus-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glad_beast',name:'C\xe3o de Fossa',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Lan\xe7ado aos condenados na arena inferior. A fome nunca cessou."',icon:'dog-side',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glad_net',name:'Ca\xe7ador de Redes',rank:'Normal',type:'Assassin',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Com as suas redes de malha dupla enredou campe\xf5es antes de lhe cortarem a garganta nas costas."',icon:'spider-web',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glad_shield',name:'Bucha de Canh\xe3o',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'penalty_reduce',value:.01,description:'-1% na perda de XP por penalidade'},lore:'"O primeiro na linha, destinado a morrer. Aprendeu a n\xe3o ceder um mil\xedmetro. Hoje nem precisa de respirar."',icon:'shield-off',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glad_boar',name:'Javali Espinhos',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Adornado com ferros dolorosos pelos donos da arena. Enlouqueceu pelas dores. Esmaga sob ordens agora."',icon:'pig',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glad_champion',name:'Veterano das Areias',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Cem vit\xf3rias consecutivas. Tra\xeddo na cent\xe9sima primeira. Ele n\xe3o esquece a l\xe2mina nas costas."',icon:'crown-outline',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'glad_tiger',name:'Dentes de Sabre Coliseu',rank:'Elite',type:'Beast',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"Nenhum gladiador humano escapou das suas presas durante tr\xeas d\xe9cadas de terror nos combates de exibi\xe7\xe3o."',icon:'cat',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'glad_hoplite',name:'Hoplita Ensanguentado',rank:'Elite',type:'Tank',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.04,description:'-4% na perda de XP por penalidade'},lore:'"A forma\xe7\xe3o nunca quebra. O corpo pode ser em peda\xe7os, o fantasma agarra a lan\xe7a ao lado dos irm\xe3os e do Monarca."',icon:'strategy',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'glad_venom',name:'Facas Envenenadas',rank:'Elite',type:'Assassin',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"Sobreviveu \xe0 base de sujidade e truques sujos. A sua adaga tem soros e toxinas de eras extintas."',icon:'flask-empty-outline',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'glad_minotaur',name:'Minotauro Escravo',rank:'Elite',type:'Tank',dropRate:.08,passiveEffect:{type:'daily_bonus',value:6,description:'+6 XP gr\xe1tis ao iniciar cada dia'},lore:'"Preso sob correntes que pesavam mais do que os blocos de pedra. Uma vez livre pelo escuro, o bater do casco faz o ch\xe3o tremer."',icon:'cow',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'glad_spartacus',name:'L\xedder dos Rejeitados',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"Chefiou uma rebeli\xe3o de escravos das arenas que amea\xe7ou imp\xe9rios inteiros. A rebeli\xe3o n\xe3o acabou."',icon:'flag-triangle',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'glad_executioner',name:'O Carrasco da Arena',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"A multid\xe3o n\xe3o gritava o seu nome. Gritava as mortes que ele entregava com o machado de dupla l\xe2mina."',icon:'axe',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'glad_lion',name:'Quimera de Batalha',rank:'Knight',type:'Beast',dropRate:.06,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Mistura biol\xf3gica injetada em arenas fechadas para purgar fracos. As suas asas carregam o terror da arena."',icon:'skull-outline',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'glad_sorcerer',name:'Cativador de Sangue',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'focus_mastery',value:.12,description:'-12% tempo de foco necess\xe1rio'},lore:'"For\xe7ado a lutar como um espet\xe1culo de magias grotescas, acabou por dominar ritos proibidos no sangue das areias."',icon:'blood-bag',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'glad_juggernaut',name:'Imperador da Dor',rank:'Commander',type:'Tank',dropRate:.02,passiveEffect:{type:'penalty_reduce',value:.15,description:'-15% na perda de XP por penalidade'},lore:'"Nunca foi ferido profundamente. A lenda na arena afirmava que ele n\xe3o tinha \xf3rg\xe3os \u2014 apenas blocos de agonia solidificada."',icon:'emoticon-angry-outline',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'glad_god',name:'Deus da Arena',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'boss_bonus_xp',value:.25,description:'+25% XP extra em Boss Raids'},lore:'"O Avatar imortal de sangue derramado. Todos que caem no coliseu abrem caminho para esta criatura. Submeteu-se pela primeira vez \xe0 autoridade do Monarca."',icon:'sword-cross',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'god_servant',name:'Acolito de Bronze',rank:'Normal',type:'Magic',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Limparam templos desmoronados das divindades esquecidas. Agora limpar\xe3o os obst\xe1culos do Monarca."',icon:'account',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'god_idol',name:'\xcddolo Fendido',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Pequenas rel\xedquias aben\xe7oadas com restos de poder caduco. In\xfateis para as bestas, inestim\xe1veis no Ex\xe9rcito Umbroso."',icon:'pot-mix',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'god_hound',name:'Mastim do Santu\xe1rio',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"C\xe3es corrompidos de est\xe1tuas antigas, desenterrados pela ess\xeancia p\xfarpura das sombras."',icon:'dog-side',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'god_scripture',name:'Papiro Amaldi\xe7oado',rank:'Elite',type:'Magic',dropRate:.08,passiveEffect:{type:'focus_mastery',value:.08,description:'-8% tempo de foco necess\xe1rio'},lore:'"Uma folha com as leis antigas \u2014 agora obedece apenas \xe0 lei do sistema, o qual substituiu as divindades mortais."',icon:'script-text-outline',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'god_sculpture',name:'Anjo de M\xe1rmore',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Querubim desfeito que a sombra restituiu com osso e vapor. Bate com f\xfaria divina desapontada."',icon:'feather',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'god_priest',name:'Sumo Sacerdote',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'penalty_reduce',value:.08,description:'-8% na perda de XP por penalidade'},lore:'"Tentou banir os desfiladeiros umbrosos do Monarca e serviu de sacrif\xedcio. Na morte compreendeu porque os deuses tremem."',icon:'church',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'god_goliath',name:'Arauto do Abismo',rank:'Knight',type:'Tank',dropRate:.06,passiveEffect:{type:'boss_bonus_xp',value:.08,description:'+8% XP extra em Boss Raids'},lore:'"Quatro bra\xe7os e armadura de obsidiana infundida por rezas f\xfateis. Uma m\xe1quina destruidora aben\xe7oada com escurid\xe3o pura."',icon:'robot',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'god_sovereign',name:'Pante\xe3o Solit\xe1rio',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'shop_discount',value:.15,description:'-15% no custo de todos os itens da Loja'},lore:'"O \xfaltimo deus do continente em forma de espectro ancestral. Inclinou a perna diante do poder ilimitado do ca\xe7ador."',icon:'chess-king',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'citadel_guard',name:'Guarda da Cidadela',rank:'Normal',type:'Warrior',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Soldado raso de um imp\xe9rio desmoronado. Levanta-se novamente sob novo estandarte."',icon:'shield',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'citadel_archer',name:'Besteiro Esqueleto',rank:'Normal',type:'Assassin',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"A sua mira melhorou sem olhos que sequem com o vento frio."',icon:'bullseye-arrow',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'abyss_crawler',name:'Rastejante do Abismo',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Alimentava-se dos restos nos calabou\xe7os de R-Rank. Agora \xe9 leal \xe0 escurid\xe3o."',icon:'bug',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'forgotten_mage',name:'Mago Esquecido',rank:'Normal',type:'Magic',dropRate:.1,passiveEffect:{type:'penalty_reduce',value:.02,description:'-2% na perda de XP por penalidade'},lore:'"Gagueja encantamentos que j\xe1 n\xe3o funcionam. Serve como distra\xe7\xe3o m\xe1gica."',icon:'auto-fix',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'dungeon_gargoyle',name:'G\xe1rgula do Portal',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Observou milh\xf5es de ca\xe7adores entrarem para a morte. Finalmente, juntou-se ao massacre."',icon:'chess-rook',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'shadow_rat_king',name:'Rei dos Ratos',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Milhares de consci\xeancias roedoras fundidas num colosso rasteiro que o Monarca subjugou."',icon:'rodent',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'iron_maid',name:'Dama de Ferro Viva',rank:'Elite',type:'Tank',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.04,description:'-4% na perda de XP por penalidade'},lore:'"Instrumento de tortura alimentado pelas almas de quem l\xe1 sofreu. Move-se lentamente na vanguarda."',icon:'door',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'crypt_assassin',name:'Assassino Estripador',rank:'Elite',type:'Assassin',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"N\xe3o usa armas, apenas unhas de osso alongadas temperadas com veneno m\xedstico."',icon:'knife-military',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'venom_weaver',name:'Tecedeira de Veneno',rank:'Elite',type:'Insect',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Aranha do tamanho de cavalos. Fia teias que dissolvem a carne dos descuidados."',icon:'spider',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'golem_magma',name:'Golem de Magma',rank:'Elite',type:'Elemental',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"Arrefeceu apenas superficialmente, quebrando e jorrando lava a cada golpe sofrido."',icon:'fire-hydrant',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'grave_robber',name:'Saqueador de Tumbas',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'daily_bonus',value:5,description:'+5 XP gr\xe1tis ao iniciar cada dia'},lore:'"Roubou aos mortos toda a vida e pagou com a sua pr\xf3pria morte nos corredores abissais."',icon:'robber',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'dark_cavalry',name:'Cavalaria Sombria',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"Cavalos descarnados montados por generais que esqueceram de que imp\xe9rio vieram."',icon:'horse',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'plague_doctor',name:'M\xe9dico da Peste',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Tentou curar a sombra. Percebeu que a sombra \xe9 a \xfanica cura contra as doen\xe7as dos deuses."',icon:'doctor',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'blood_hound',name:'C\xe3o de Sangue Alfa',rank:'Knight',type:'Beast',dropRate:.05,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Pode rastrear presas no passado e atrav\xe9s de outras dimens\xf5es menores."',icon:'dog-side',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'gargantua',name:'Garg\xe2ntua Mudo',rank:'Knight',type:'Tank',dropRate:.05,passiveEffect:{type:'gold_boost',value:.04,description:'+4% Gold em todas as miss\xf5es'},lore:'"Sem cordas vocais, o seu sil\xeancio enlouquece quem ouve o ru\xeddo das suas pesadas passadas met\xe1licas."',icon:'weight',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'abyss_warlock',name:'Feiticeiro Abissal',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'focus_mastery',value:.1,description:'-10% tempo de foco necess\xe1rio'},lore:'"Canalizou o v\xe1cuo de uma dimens\xe3o est\xe9ril, vendendo a sanidade pelo foco inquebr\xe1vel da sombra."',icon:'book-open-blank-variant',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'cursed_inquisitor',name:'Inquisidor Amaldi\xe7oado',rank:'Commander',type:'Warrior',dropRate:.02,passiveEffect:{type:'penalty_immunity',value:1,description:'Imunidade completa a 1 penalidade por semana'},lore:'"Ca\xe7ador de hereges que deparou com a divindade incorreta e pagou at\xe9 ao osso. Impiedoso contra qualquer adversidade."',icon:'fire-circle',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'royal_assassin',name:'Assassino Real',rank:'Commander',type:'Assassin',dropRate:.02,passiveEffect:{type:'focus_mastery',value:.18,description:'-18% tempo de foco necess\xe1rio'},lore:'"Trabalhava nas sombras para imperadores fr\xe1geis. Serve a escurid\xe3o suprema sob promessa de caos silenciado."',icon:'incognito',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'monolith',name:'O Mon\xf3lito Primitivo',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'shop_discount',value:.15,description:'-15% no custo de todos os itens da Loja'},lore:'"Uma rocha senciente com vinte metros de altura que o Sistema marcava como indom\xe1vel. Destr\xf3i economias inteiras s\xf3 de aterrar."',icon:'pillar',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'star_breaker',name:'Quebrador de Estrelas',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'xp_boost',value:.2,description:'+20% XP em todas as miss\xf5es'},lore:'"O poder comprimido de cometas em rota de colis\xe3o manifestado em bra\xe7os de poeira c\xf3smica. Concede um crescimento sem precedentes aos seus pares umbrosos."',icon:'earth',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'cave_dweller',name:'Habitante das Grutas',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Os seus olhos adaptaram-se \xe0 escurid\xe3o muito antes de se fundir a ela."',icon:'eye-off-outline',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'rust_hound',name:'C\xe3o Ferruginoso',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Corro\xeddo por chuvas \xe1cidas nas arenas abertas. Forte e desesparado."',icon:'dog',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'bone_collector',name:'Colecionador de Ossos',rank:'Normal',type:'Undead',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"As montanhas de esqueletos na Cripta eram o seu parque de divers\xf5es."',icon:'bone',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'blind_seer',name:'Vidente Cego',rank:'Normal',type:'Magic',dropRate:.1,passiveEffect:{type:'focus_mastery',value:.05,description:'-5% tempo de foco necess\xe1rio'},lore:'"Previu a ascens\xe3o do Monarca. Arrancou os pr\xf3prios olhos porque a vis\xe3o era aterradora."',icon:'eye-off',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'bronze_hoplite',name:'Hoplita de Bronze',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"Defendeu as encostas contra hordas maiores. Como sombra, ele nunca cede um passo."',icon:'shield',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'void_manta',name:'Manta do Vazio',rank:'Elite',type:'Beast',dropRate:.08,passiveEffect:{type:'penalty_reduce',value:.04,description:'-4% na perda de XP por penalidade'},lore:'"Planava sobre fal\xe9sias dimensionais, sugando a humidade m\xe1gica do ar."',icon:'sail-boat',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'cursed_samurai',name:'Samurai Vingativo',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Lutou sem senhor em vida. Encontrou na morte o Lorde das Sombras perfeito."',icon:'sword',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'swamp_behemoth',name:'Behemoth de Lodo',rank:'Elite',type:'Tank',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"Corpo feito de lamas t\xf3xicas e cad\xe1veres petrificados de antigas expedi\xe7\xf5es."',icon:'water-pump',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'crystal_golem',name:'Golem de Cristal',rank:'Elite',type:'Elemental',dropRate:.08,passiveEffect:{type:'daily_bonus',value:5,description:'+5 XP gr\xe1tis ao iniciar cada dia'},lore:'"Refratava magia em focos mortais no Ninho de Cristal Perdido."',icon:'diamond',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'ember_knight',name:'Cavaleiro de Fogo',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'streak_protect',value:1,description:'Protege o streak uma vez por semana'},lore:'"O seu elmo irradia calor constante. As suas pegadas derretem o ch\xe3o em que pisa."',icon:'fire-hydrant',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'frostbite_mage',name:'Mago da Geada Mort\xedfera',rank:'Knight',type:'Magic',dropRate:.06,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Congelou as almas de um ex\xe9rcito inteiro de goblins e, em seguida, a si mesmo."',icon:'snowflake-melt',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'silent_blade',name:'L\xe2mina Silenciosa',rank:'Knight',type:'Assassin',dropRate:.05,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"N\xe3o usa passos verbais nem ru\xeddos met\xe1licos. Apenas fatias perfeitas e sil\xeancio absoluto."',icon:'knife',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'titan_ape',name:'Primata Tit\xe2nico',rank:'Knight',type:'Beast',dropRate:.05,passiveEffect:{type:'gold_boost',value:.04,description:'+4% Gold em todas as miss\xf5es'},lore:'"Derrubava florestas antigas apenas para aquecer os m\xfasculos. Adora a carnificina."',icon:'ape',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'storm_bringer',name:'Invocador de Tempestades',rank:'Commander',type:'Elemental',dropRate:.02,passiveEffect:{type:'boss_bonus_xp',value:.15,description:'+15% XP extra em Boss Raids'},lore:'"Nasceu nos c\xe9us tempestuosos. Rasga nuvens negras quando invocado, gerando rel\xe2mpagos massivos."',icon:'weather-lightning',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'chrono_master',name:'Senhor do Tempo',rank:'Marshal',type:'Ancient',dropRate:.005,passiveEffect:{type:'shop_discount',value:.15,description:'-15% no custo de todos os itens da Loja'},lore:'"Uma criatura que manipula fluxos temporais menores. Concedeu a si pr\xf3prio juventude at\xe9 a l\xe2mina do Monarca travar o seu feiti\xe7o."',icon:'timer-sand',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'dune_scamp',name:'Saqueador das Dunas',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Aprendeu a sobreviver com quase nada. Leal a quem lhe d\xe1 prop\xf3sito."',icon:'dog',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'library_wisp',name:'Fa\xedsca da Biblioteca',rank:'Normal',type:'Magic',dropRate:.1,passiveEffect:{type:'focus_mastery',value:.1,description:'-10% tempo de foco necess\xe1rio'},lore:'"Sussurra p\xe1ginas antigas quando o sil\xeancio \xe9 total."',icon:'book-open-variant',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'rust_sentinel',name:'Sentinela Ferrugem',rank:'Normal',type:'Tank',dropRate:.1,passiveEffect:{type:'boss_bonus_xp',value:.02,description:'+2% XP extra em Boss Raids'},lore:'"Quebrou mil l\xe2minas antes de aceitar a tua."',icon:'shield-check',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'glacier_stalker',name:'Espreitador Glacial',rank:'Elite',type:'Assassin',dropRate:.08,passiveEffect:{type:'xp_boost',value:.03,description:'+3% XP em todas as miss\xf5es'},lore:'"Move-se entre estalidos de gelo. S\xf3 deixa pegadas quando quer."',icon:'snowflake',color:'#60a5fa',unlockMethod:{type:'gacha'}},{id:'ember_squire',name:'Escudeiro de Brasas',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.03,description:'+3% Gold em todas as miss\xf5es'},lore:'"Treinado a servir cavaleiros de fogo. Agora serve o Monarca."',icon:'fire',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'storm_lancer',name:'Lanceiro da Tempestade',rank:'Knight',type:'Warrior',dropRate:.06,passiveEffect:{type:'boss_bonus_xp',value:.06,description:'+6% XP extra em Boss Raids'},lore:'"Carrega trov\xf5es na ponta da lan\xe7a. Nunca falha o primeiro golpe."',icon:'sword',color:'#38bdf8',unlockMethod:{type:'gacha'}},{id:'hollow_knight',name:'O Cavaleiro do Vazio',rank:'Marshal',type:'Warrior',dropRate:.005,passiveEffect:{type:'xp_boost',value:.15,description:'+15% XP em todas as miss\xf5es'},lore:'"Um recet\xe1culo que n\xe3o conhece o medo nem a dor. O seu sil\xeancio \xe9 a sua for\xe7a e a sua alma \xe9 feita de sombra pura."',icon:'chess-knight',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'legend_guts',name:'O Cruzado do A\xe7o Negro',rank:'Marshal',type:'Warrior',dropRate:.005,passiveEffect:{type:'penalty_reduce',value:.25,description:'-25% na perda de XP por penalidade'},lore:'"Sobreviveu ao impens\xe1vel. A sua espada, grande demais para ser chamada de espada, corta o pr\xf3prio destino amaldi\xe7oado."',icon:'sword',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'legend_saitama',name:'O \xc1pice da Singularidade',rank:'Marshal',type:'Warrior',dropRate:.005,passiveEffect:{type:'boss_bonus_xp',value:.3,description:'+30% XP extra em Boss Raids'},lore:'"Alcan\xe7ou o limite e quebrou-o. N\xe3o h\xe1 nada que este punho n\xe3o possa pulverizar num \xfanico e aborrecido golpe."',icon:'hand-back-right',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'legend_kratos',name:'O Algoz de Deuses',rank:'Marshal',type:'Warrior',dropRate:.005,passiveEffect:{type:'boss_bonus_xp',value:.25,description:'+25% XP extra em Boss Raids'},lore:'"A sua f\xfaria derrubou pante\xf5es inteiros. Coberto pelas cinzas do passado, ele \xe9 agora a l\xe2mina final do Monarca."',icon:'axe',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'legend_sukuna',name:'O Rei das Maldi\xe7\xf5es',rank:'Marshal',type:'Magic',dropRate:.005,passiveEffect:{type:'gold_boost',value:.25,description:'+25% Gold em todas as miss\xf5es'},lore:'"Quatro bra\xe7os, duas faces e um desd\xe9m absoluto pela vida. O mal encarnado que agora se curva perante a sombra."',icon:'skull',color:'#ef4444',unlockMethod:{type:'gacha'}},{id:'legend_artoria',name:'A Promessa da T\xe1vola Redonda',rank:'Commander',type:'Warrior',dropRate:.02,passiveEffect:{type:'gold_boost',value:.15,description:'+15% Gold em todas as miss\xf5es'},lore:'"Uma rainha que nunca falhou com o seu povo. A sua l\xe2mina invis\xedvel brilha com a esperan\xe7a de uma era esquecida."',icon:'sword-cross',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'legend_cloud',name:'O Mercen\xe1rio do Olhar de Mako',rank:'Commander',type:'Warrior',dropRate:.02,passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"Os seus olhos brilham com uma energia proibida. Carrega uma l\xe2mina colossal que desafia a gravidade e a mem\xf3ria."',icon:'sword',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'legend_ichigo',name:'O Portador do Luar Negro',rank:'Commander',type:'Assassin',dropRate:.02,passiveEffect:{type:'focus_mastery',value:.2,description:'-20% tempo de foco necess\xe1rio'},lore:'"Move-se entre o mundo dos vivos e dos mortos. O seu corte final \xe9 um grito de escurid\xe3o absoluta que rasga o c\xe9u."',icon:'moon-waning-crescent',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'legend_luffy',name:'O Rei da Liberta\xe7\xe3o',rank:'Commander',type:'Warrior',dropRate:.02,passiveEffect:{type:'daily_bonus',value:25,description:'+25 XP gr\xe1tis ao iniciar cada dia'},lore:'"O seu corpo \xe9 fluido como borracha, o seu esp\xedrito \xe9 indom\xe1vel. Ele traz o ritmo da liberta\xe7\xe3o para o campo de batalha."',icon:'sun-wireless',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'legend_itachi',name:'O Corvo do Olhar Carmesim',rank:'Commander',type:'Magic',dropRate:.02,passiveEffect:{type:'penalty_immunity',value:1,description:'Imunidade completa a 1 penalidade por semana'},lore:'"Viveu no sacrif\xedcio e na ilus\xe3o. O seu olhar consome a pr\xf3pria alma em chamas negras que nunca se apagam."',icon:'bird',color:'#f59e0b',unlockMethod:{type:'gacha'}},{id:'legend_eren',name:'O Tit\xe3 da Inevitabilidade',rank:'Knight',type:'Tank',dropRate:.05,passiveEffect:{type:'streak_protect',value:2,description:'Protege o streak duas vezes por semana'},lore:'"Avan\xe7a sempre, sem nunca olhar para tr\xe1s. A liberdade tem um custo mundial, e ele \xe9 o portador do rugido final."',icon:'account-group',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'legend_zoro',name:'Asura, o Dem\xf3nio das L\xe2minas',rank:'Knight',type:'Warrior',dropRate:.05,passiveEffect:{type:'boss_bonus_xp',value:.1,description:'+10% XP extra em Boss Raids'},lore:'"Tr\xeas l\xe2minas, um \xfanico caminho de sangue e honra. O seu esp\xedrito manifesta-se como um dem\xf3nio de nove bra\xe7os."',icon:'sword-cross',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'legend_kirito',name:'O Prisioneiro do A\xe7o',rank:'Knight',type:'Warrior',dropRate:.05,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Sobreviveu a mundos de ilus\xe3o digital atrav\xe9s da for\xe7a bruta. A sua velocidade com l\xe2minas duplas \xe9 lend\xe1ria."',icon:'sword',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'legend_jotaro',name:'O Arauto do Tempo Imobilizado',rank:'Knight',type:'Warrior',dropRate:.05,passiveEffect:{type:'focus_mastery',value:.12,description:'-12% tempo de foco necess\xe1rio'},lore:'"Para o mundo por um breve instante apenas para desferir uma barragem de golpes invis\xedveis e avassaladores."',icon:'hand-back-right',color:'#3b82f6',unlockMethod:{type:'gacha'}},{id:'legend_rimuru',name:'O Monarca do Caos Azul',rank:'Elite',type:'Magic',dropRate:.08,passiveEffect:{type:'shop_discount',value:.1,description:'-10% no custo de todos os itens da Loja'},lore:'"Uma forma pequena e in\xf3cua que esconde uma fome infinita por habilidades. Evolui ao consumir o imposs\xedvel."',icon:'water-outline',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'legend_tanjiro',name:'O Ca\xe7ador da Alvorada',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"A sua respira\xe7\xe3o ecoa o calor do sol. Cada golpe \xe9 uma dan\xe7a de purifica\xe7\xe3o contra a escurid\xe3o que consome o mundo."',icon:'fire',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'legend_dabi',name:'O Herdeiro das Chamas Azuis',rank:'Elite',type:'Magic',dropRate:.08,passiveEffect:{type:'boss_bonus_xp',value:.05,description:'+5% XP extra em Boss Raids'},lore:'"Chamas que ardem mais intensamente que o sol, alimentadas por um rancor familiar que nunca arrefece."',icon:'fire-circle',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'legend_edward',name:'O Alquimista de Metal Sombrio',rank:'Elite',type:'Warrior',dropRate:.08,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"Trocou partes de si por conhecimento proibido. Transmuta o solo em armas letais num piscar de olhos."',icon:'arm-flex-outline',color:'#22c55e',unlockMethod:{type:'gacha'}},{id:'legend_pikachu',name:'Trov\xe3o Primordial Est\xe1tico',rank:'Normal',type:'Elemental',dropRate:.1,passiveEffect:{type:'daily_bonus',value:10,description:'+10 XP gr\xe1tis ao iniciar cada dia'},lore:'"Um roedor que carrega a f\xfaria do rel\xe2mpago nas suas bochechas. Pequeno, mas capaz de paralisar gigantes."',icon:'flash',color:'#94a3b8',unlockMethod:{type:'gacha'}},{id:'legend_sonic',name:'O Rel\xe2mpago Azul Vibrante',rank:'Normal',type:'Assassin',dropRate:.1,passiveEffect:{type:'xp_boost',value:.02,description:'+2% XP em todas as miss\xf5es'},lore:'"Ultrapassa a barreira do som num borr\xe3o azul fren\xe9tico. O inimigo cai antes de sequer ouvir o vento passar."',icon:'run-fast',color:'#94a3b8',unlockMethod:{type:'gacha'}}]},500,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SHADOWS_ACHIEVEMENT=void 0;e.SHADOWS_ACHIEVEMENT=[{id:'shadow_wisp',name:'Chama Sombria',rank:'Normal',type:'Undead',dropRate:0,passiveEffect:{type:'xp_boost',value:.02,description:'+2% XP em todas as miss\xf5es'},lore:'"Uma alma que n\xe3o sabe que est\xe1 morta. Erra pelos corredores do dungeon como uma chama que recusa apagar-se. A primeira compra transforma-a em lealdade."',icon:'candle',color:'#94a3b8',unlockMethod:{type:'achievement',id:'economy_first_purchase'}},{id:'moonlit_stalker',name:'Ca\xe7ador da Lua',rank:'Elite',type:'Assassin',dropRate:0,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Operava exclusivamente durante a noite. Os ca\xe7adores da madrugada conhecem o seu olhar. Completar o Dungeon de Foco revelou a sua exist\xeancia."',icon:'moon-waxing-crescent',color:'#22c55e',unlockMethod:{type:'achievement',id:'focus_crimson_knight'}},{id:'mind_flayer',name:'Devorador de Mentes',rank:'Knight',type:'Magic',dropRate:0,passiveEffect:{type:'daily_bonus',value:15,description:'+15 XP gr\xe1tis ao iniciar cada dia'},lore:'"Alimentava-se de consci\xeancias. Os ca\xe7adores que entravam no seu dungeon sa\xedam vazios. O Monarca entrou cheio e saiu com mais. O Devorador nunca entendeu porqu\xea."',icon:'brain',color:'#3b82f6',unlockMethod:{type:'achievement',id:'focus_night_owl'}},{id:'void_monarch_fragment',name:'Fragmento do Monarca Sombrio',rank:'Commander',type:'Ancient',dropRate:0,passiveEffect:{type:'boss_bonus_xp',value:.2,description:'+20% XP extra em Boss Raids'},lore:'"Um eco do Soberano Sombrio anterior. Quando derrotes o Guardi\xe3o, este fragmento reconhece em ti a mesma chama. N\xe3o serve por obriga\xe7\xe3o \u2014 serve por reconhecimento."',icon:'star-four-points',color:'#f59e0b',unlockMethod:{type:'achievement',id:'boss_cerberus'}},{id:'architect_of_ruin',name:'Arquiteto da Ru\xedna',rank:'Marshal',type:'Ancient',dropRate:0,passiveEffect:{type:'daily_bonus',value:30,description:'+30 XP gr\xe1tis ao iniciar cada dia'},lore:'"Construiu os primeiros dungeons como pris\xf5es para deuses ca\xeddos. O seu poder sobre a concentra\xe7\xe3o \xe9 absoluto \u2014 cada sess\xe3o de foco na sua presen\xe7a torna-se uma eternidade produtiva."',icon:'castle',color:'#ef4444',unlockMethod:{type:'achievement',id:'secret_monarch'}},{id:'imp',name:'Imp das Trevas',rank:'Normal',type:'Demon',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Pequeno. Ruidoso. Completamente sem honra. E ainda assim, leal ao novo mestre da forma mais absoluta."',icon:'bat',color:'#94a3b8',unlockMethod:{type:'achievement',id:'shadow_collector_10'}},{id:'dungeon_rat',name:'Rato do Dungeon',rank:'Normal',type:'Beast',dropRate:.1,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Sobreviveu a dungeons que devastaram ca\xe7adores de C-Rank. N\xe3o pela for\xe7a. Pela ast\xfacia e pela fuga."',icon:'rodent',color:'#94a3b8',unlockMethod:{type:'achievement',id:'perfect_week_1'}},{id:'cursed_peasant',name:'Campon\xeas Amaldi\xe7oado',rank:'Normal',type:'Undead',dropRate:.12,passiveEffect:{type:'daily_bonus',value:2,description:'+2 XP gr\xe1tis ao iniciar cada dia'},lore:'"Trabalhou a terra at\xe9 que a terra o engoliu. Ainda dobra as costas \u2014 mas agora \xe9 para o Monarca que semeia."',icon:'shovel',color:'#94a3b8',unlockMethod:{type:'achievement',id:'level_50_milestone'}},{id:'cave_bat',name:'Morcego das Trevas',rank:'Normal',type:'Beast',dropRate:.11,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Nunca viu a luz do sol em vida. Na morte, voa mais r\xe1pido \u2014 o escuro \xe9 o seu lar e o Monarca \xe9 o seu norte."',icon:'bat',color:'#94a3b8',unlockMethod:{type:'achievement',id:'boss_slayer_20'}},{id:'toxic_sprite',name:'Sprite T\xf3xico',rank:'Normal',type:'Elemental',dropRate:.09,passiveEffect:{type:'penalty_reduce',value:.02,description:'-2% na perda de XP por penalidade'},lore:'"Cresceu nas paredes p\xfatridas dos dungeons de p\xe2ntano. O seu toque corro\xeda armaduras. A sua presen\xe7a corroe o azar."',icon:'flask',color:'#94a3b8',unlockMethod:{type:'achievement',id:'penalty_comeback'}},{id:'shadow_monarch_disciple',name:'Disc\xedpulo do Monarca',rank:'Elite',type:'Support',dropRate:0,passiveEffect:{type:'xp_boost',value:.05,description:'+5% XP em todas as miss\xf5es'},lore:'"Dedicou a sua eternidade a estudar os teus passos. Alcan\xe7ar o N\xedvel 100 atraiu a sua imensa curiosidade."',icon:'school',color:'#22c55e',unlockMethod:{type:'achievement',id:'level_chain'}},{id:'shadow_gold_miner',name:'Mineiro de Ouro Sombrio',rank:'Elite',type:'Artisan',dropRate:0,passiveEffect:{type:'gold_boost',value:.1,description:'+10% Gold em todas as miss\xf5es'},lore:'"Encontrou o tesouro final. Agora, ele garante que nunca te falte ouro."',icon:'pickaxe',color:'#22c55e',unlockMethod:{type:'achievement',id:'economy_hoarder'}},{id:'shadow_streak_guardian',name:'Guardi\xe3o da Const\xe2ncia',rank:'Knight',type:'Support',dropRate:0,passiveEffect:{type:'streak_protect',value:1,description:'Protege a Streak uma vez por semana'},lore:'"Ele vigia o teu sono e a tua vontade. 30 dias de foco ininterrupto evocaram esta sombra persistente."',icon:'timer',color:'#3b82f6',unlockMethod:{type:'achievement',id:'streak_chain'}},{id:'shadow_boss_conqueror',name:'Caminhante das Ru\xednas',rank:'Knight',type:'Warrior',dropRate:0,passiveEffect:{type:'boss_bonus_xp',value:.1,description:'+10% XP extra em Boss Raids'},lore:'"Conquistou cem campos de batalha. O sangue dos boss agora lubrifica a sua l\xe2mina."',icon:'sword-cross',color:'#3b82f6',unlockMethod:{type:'achievement',id:'boss_slayer'}},{id:'shadow_key_master',name:'Mestre das Chaves Sombrio',rank:'Knight',type:'Thief',dropRate:0,passiveEffect:{type:'loot_perception',value:.15,description:'+15% chance de encontrar boxes de loot'},lore:'"Nenhuma porta se mant\xe9m fechada perante ele. 50 dungeons abertos atra\xedram este mestre dos segredos."',icon:'key-chain',color:'#3b82f6',unlockMethod:{type:'achievement',id:'dungeon_master_50'}},{id:'shadow_focus_titan',name:'Tit\xe3 da Concentra\xe7\xe3o',rank:'Commander',type:'Support',dropRate:0,passiveEffect:{type:'focus_mastery',value:.15,description:'-15% tempo de foco necess\xe1rio'},lore:'"Passou mil horas em medita\xe7\xe3o profunda. A sua mente \xe9 uma fortaleza inexpugn\xe1vel."',icon:'meditation',color:'#f59e0b',unlockMethod:{type:'achievement',id:'focus_hours'}},{id:'shadow_gps_explorer',name:'Explorador do Horizonte',rank:'Commander',type:'Explorer',dropRate:0,passiveEffect:{type:'xp_boost',value:.12,description:'+12% XP em todas as miss\xf5es'},lore:'"Percorreu o mundo inteiro sem nunca parar. 100km de jornada despertaram o seu interesse."',icon:'map-search',color:'#f59e0b',unlockMethod:{type:'achievement',id:'boss_runner'}},{id:'shadow_penalty_survivor',name:'Sobrevivente do Vazio',rank:'Commander',type:'Undead',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.3,description:'-30% na perda de XP por penalidade'},lore:'"Caiu no vazio repetidamente e sempre voltou. As falhas agora s\xe3o o seu alimento."',icon:'skull-scan',color:'#f59e0b',unlockMethod:{type:'achievement',id:'penalty_veteran'}},{id:'shadow_collection_completionist',name:'Arquivista de Sombras',rank:'Marshal',type:'General',dropRate:0,passiveEffect:{type:'xp_boost',value:.25,description:'+25% XP em todas as miss\xf5es'},lore:'"Ele guarda a genealogia de todas as sombras. Ter uma cole\xe7\xe3o vasta \xe9 o \xfanico crit\xe9rio para o seu servi\xe7o."',icon:'library',color:'#ef4444',unlockMethod:{type:'achievement',id:'shadow_army'}},{id:'shadow_national_hero_echo',name:'Eco do Her\xf3i Nacional',rank:'Marshal',type:'Warrior',dropRate:0,passiveEffect:{type:'all_stats_boost',value:.1,description:'+10% em todos os b\xf3nus de sombra'},lore:'"Um eco de algu\xe9m que um dia salvou a humanidade. Reconhece em ti o mesmo potencial divino."',icon:'crown',color:'#ef4444',unlockMethod:{type:'achievement',id:'quests_perfect'}}]},501,[]);
__d(function(g,r,i,a,m,e,d){Object.defineProperty(e,"__esModule",{value:!0}),e.SHADOWS_SHOP=void 0;e.SHADOWS_SHOP=[{id:'venal_duelist',name:'Duelista Venal',rank:'Elite',type:'Warrior',dropRate:0,passiveEffect:{type:'gold_boost',value:.04,description:'+4% Gold em todas as miss\xf5es'},lore:'"Lutava por quem pagasse mais. Morreu por um contrato. Serve agora sem necessidade de pagamento \u2014 a morte simplifica os contratos."',icon:'sword-cross',color:'#22c55e',unlockMethod:{type:'shop',price:2e3}},{id:'hired_golem',name:'Golem de Aluguer',rank:'Elite',type:'Tank',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.05,description:'-5% na perda de XP por penalidade'},lore:'"Constru\xeddo por um mago mercen\xe1rio para ser vendido a qualquer senhor. O \xfaltimo comprador foi o Monarca. E desta vez, n\xe3o h\xe1 devolu\xe7\xe3o."',icon:'robot',color:'#22c55e',unlockMethod:{type:'shop',price:2e3}},{id:'shadow_mercenary',name:'Mercen\xe1rio das Sombras',rank:'Knight',type:'Assassin',dropRate:0,passiveEffect:{type:'gold_boost',value:.06,description:'+6% Gold em todas as miss\xf5es'},lore:'"Trabalhou para os cinco maiores Guildas antes de os trair a todos. Agora serve apenas um. E desta vez, a trai\xe7\xe3o \xe9 imposs\xedvel \u2014 est\xe1 morto."',icon:'cash',color:'#3b82f6',unlockMethod:{type:'shop',price:7500}},{id:'iron_sentinel',name:'Sentinela de Ferro',rank:'Knight',type:'Tank',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.07,description:'-7% na perda de XP por penalidade'},lore:'"Constru\xeddo por um rei paranoico para guardar o seu tesouro. O tesouro foi saqueado. A Sentinela manteve o posto. O Monarca comprou o posto."',icon:'robot-angry',color:'#3b82f6',unlockMethod:{type:'shop',price:7500}},{id:'dark_arbiter',name:'\xc1rbitro das Trevas',rank:'Commander',type:'Ancient',dropRate:0,passiveEffect:{type:'xp_boost',value:.15,description:'+15% XP em todas as miss\xf5es'},lore:'"Existiu antes dos Guildas, antes dos Ca\xe7adores, antes das regras. Julga cada a\xe7\xe3o sem miseric\xf3rdia. O Monarca comprou a sua neutralidade \u2014 e converteu-a em servi\xe7o."',icon:'scale-balance',color:'#f59e0b',unlockMethod:{type:'shop',price:2e4}},{id:'void_sovereign',name:'Soberano do Vazio',rank:'Marshal',type:'Demon',dropRate:0,passiveEffect:{type:'shop_discount',value:.2,description:'-20% no custo de todos os itens da Loja'},lore:'"Governou o espa\xe7o entre os dungeons \u2014 o vazio onde nem a magia nem o a\xe7o chegam. O seu poder sobre o com\xe9rcio sombrio \xe9 absoluto. Compra-o e tudo ficar\xe1 mais barato. Por um pre\xe7o."',icon:'infinity',color:'#ef4444',unlockMethod:{type:'shop',price:5e4}},{id:'goblin_grunt',name:'Goblin Grunt',rank:'Normal',type:'Beast',dropRate:.18,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Era apenas um escudeiro antes de cair. Agora serve sem questionamento. O mais fraco dos ex\xe9rcitos ainda \xe9 um ex\xe9rcito."',icon:'alien',color:'#94a3b8',unlockMethod:{type:'shop',price:15e3}},{id:'cave_spider',name:'Aranha das Cavernas',rank:'Normal',type:'Beast',dropRate:.15,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Teceu teias na escurid\xe3o durante s\xe9culos. As suas presas nunca souberam que estava l\xe1 at\xe9 ser tarde demais."',icon:'spider',color:'#94a3b8',unlockMethod:{type:'shop',price:15e3}},{id:'ant_worker',name:'Formiga Oper\xe1ria',rank:'Normal',type:'Insect',dropRate:.14,passiveEffect:{type:'gold_boost',value:.01,description:'+1% Gold em todas as miss\xf5es'},lore:'"Na col\xf3nia, a sua fun\xe7\xe3o era escavar. Na morte, a sua fun\xe7\xe3o \xe9 a mesma \u2014 construir a grandeza do Monarca."',icon:'bug',color:'#94a3b8',unlockMethod:{type:'shop',price:15e3}},{id:'skeleton_archer',name:'Arqueiro Esqueleto',rank:'Normal',type:'Undead',dropRate:.12,passiveEffect:{type:'xp_boost',value:.01,description:'+1% XP em todas as miss\xf5es'},lore:'"Os seus olhos j\xe1 n\xe3o v\xeaem. Mas a mem\xf3ria dos m\xfasculos permanece \u2014 cada flecha ainda encontra o alvo."',icon:'skull',color:'#94a3b8',unlockMethod:{type:'shop',price:15e3}},{id:'stone_golem_shard',name:'Fragmento de Golem',rank:'Normal',type:'Tank',dropRate:.11,passiveEffect:{type:'penalty_reduce',value:.02,description:'-2% na perda de XP por penalidade'},lore:'"Apenas um fragmento do golem original sobreviveu \xe0 invoca\xe7\xe3o. Mas mesmo fragmentado, resiste."',icon:'cube-outline',color:'#94a3b8',unlockMethod:{type:'shop',price:15e3}},{id:'shadow_coin_collector',name:'Colecionador de Moedas',rank:'Normal',type:'Thief',dropRate:0,passiveEffect:{type:'gold_boost',value:.02,description:'+2% Gold em todas as miss\xf5es'},lore:'"Um ladr\xe3o que roubou o tesouro errado. Agora as moedas que encontra pertencem ao Monarca."',icon:'cookie-outline',color:'#94a3b8',unlockMethod:{type:'shop',price:1500}},{id:'rotten_vanguard',name:'Vanguarda Podre',rank:'Normal',type:'Warrior',dropRate:0,passiveEffect:{type:'xp_boost',value:.02,description:'+2% XP em todas as miss\xf5es'},lore:'"Um soldado esquecido numa trincheira. O Sistema deu-lhe uma nova ordem: Avan\xe7ar."',icon:'shield-outline',color:'#94a3b8',unlockMethod:{type:'shop',price:1500}},{id:'hired_blade_shadow',name:'L\xe2mina de Aluguer Sombria',rank:'Elite',type:'Assassin',dropRate:0,passiveEffect:{type:'gold_boost',value:.05,description:'+5% Gold em todas as miss\xf5es'},lore:'"A morte n\xe3o rescindiu o seu contrato. Apenas mudou o benefici\xe1rio."',icon:'knife-military',color:'#22c55e',unlockMethod:{type:'shop',price:3e3}},{id:'obsidian_golem_mini',name:'Mini Golem de Obsidiana',rank:'Elite',type:'Tank',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.06,description:'-6% na perda de XP por penalidade'},lore:'"Uma constru\xe7\xe3o defensiva de um castelo em ru\xednas. Pesado, lento e absolutamente fiel."',icon:'rhombus-split',color:'#22c55e',unlockMethod:{type:'shop',price:3e3}},{id:'shadow_apprentice_mage',name:'Aprendiz de Mago Sombrio',rank:'Elite',type:'Mage',dropRate:0,passiveEffect:{type:'xp_boost',value:.04,description:'+4% XP em todas as miss\xf5es'},lore:'"Falhou no seu \xfaltimo ritual. O Monarca terminou o feiti\xe7o por ele."',icon:'auto-fix',color:'#22c55e',unlockMethod:{type:'shop',price:3e3}},{id:'void_merchant_guard',name:'Guarda do Mercador do Vazio',rank:'Knight',type:'Warrior',dropRate:0,passiveEffect:{type:'gold_boost',value:.08,description:'+8% Gold em todas as miss\xf5es'},lore:'"Protegia caravanas entre mundos. Agora protege a economia do Sistema."',icon:'shield-account',color:'#3b82f6',unlockMethod:{type:'shop',price:8e3}},{id:'cursed_tomb_watcher',name:'Vigia da Tumba Amaldi\xe7oada',rank:'Knight',type:'Undead',dropRate:0,passiveEffect:{type:'xp_boost',value:.07,description:'+7% XP em todas as miss\xf5es'},lore:'"Vigiou o sil\xeancio por mil anos. O Monarca deu-lhe uma voz: O grito da Sombra."',icon:'eye-circle',color:'#3b82f6',unlockMethod:{type:'shop',price:8e3}},{id:'shadow_blacksmith',name:'Ferreiro das Sombras',rank:'Knight',type:'Artisan',dropRate:0,passiveEffect:{type:'gold_boost',value:.07,description:'+7% Gold em todas as miss\xf5es'},lore:'"Martelava o a\xe7o at\xe9 o sangue ferver. Agora martela o destino."',icon:'hammer',color:'#3b82f6',unlockMethod:{type:'shop',price:8500}},{id:'abyssal_navigator',name:'Navegador Abissal',rank:'Knight',type:'Explorer',dropRate:0,passiveEffect:{type:'xp_boost',value:.08,description:'+8% XP em todas as miss\xf5es'},lore:'"Guiou navios por mares de escurid\xe3o. O Sistema \xe9 o seu novo oceano."',icon:'compass',color:'#3b82f6',unlockMethod:{type:'shop',price:9e3}},{id:'dark_alchemist_shadow',name:'Alquimista Escuro',rank:'Commander',type:'Mage',dropRate:0,passiveEffect:{type:'xp_boost',value:.12,description:'+12% XP em todas as miss\xf5es'},lore:'"Procurava a vida eterna. Encontrou a imortalidade na Sombra do Monarca."',icon:'bottle-tonic-skull',color:'#f59e0b',unlockMethod:{type:'shop',price:25e3}},{id:'iron_lord_shadow',name:'Lorde de Ferro Sombrio',rank:'Commander',type:'Warrior',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.15,description:'-15% na perda de XP por penalidade'},lore:'"Um tirano que nunca se curvou. Na morte, reconheceu um soberano maior."',icon:'crown',color:'#f59e0b',unlockMethod:{type:'shop',price:22e3}},{id:'shadow_treasury_haunter',name:'Assombrador do Tesouro',rank:'Commander',type:'Ghost',dropRate:0,passiveEffect:{type:'gold_boost',value:.15,description:'+15% Gold em todas as miss\xf5es'},lore:'"Um esp\xedrito ganancioso que n\xe3o largava o seu ouro. O Monarca comprou o esp\xedrito e o ouro."',icon:'bank',color:'#f59e0b',unlockMethod:{type:'shop',price:28e3}},{id:'eternal_executioner',name:'Executor Eterno',rank:'Commander',type:'Warrior',dropRate:0,passiveEffect:{type:'xp_boost',value:.14,description:'+14% XP em todas as miss\xf5es'},lore:'"Cortou cabe\xe7as em nome da lei. Agora corta o ar em nome da Sombra."',icon:'axe',color:'#f59e0b',unlockMethod:{type:'shop',price:26e3}},{id:'marshal_of_ruin',name:'Marechal da Ru\xedna',rank:'Marshal',type:'General',dropRate:0,passiveEffect:{type:'xp_boost',value:.25,description:'+25% XP em todas as miss\xf5es'},lore:'"Liderou ex\xe9rcitos \xe0 destrui\xe7\xe3o total. O Monarca deu-lhe um novo ex\xe9rcito para liderar."',icon:'chess-knight',color:'#ef4444',unlockMethod:{type:'shop',price:6e4}},{id:'phantom_vizier',name:'Vizir Fantasmag\xf3rico',rank:'Marshal',type:'Ancient',dropRate:0,passiveEffect:{type:'gold_boost',value:.2,description:'+20% Gold em todas as miss\xf5es'},lore:'"O conselheiro secreto de imp\xe9rios ca\xeddos. Os seus sussurros agora guiam o Sistema."',icon:'account-tie-voice',color:'#ef4444',unlockMethod:{type:'shop',price:55e3}},{id:'chaos_bringer_shadow',name:'Portador do Caos',rank:'Marshal',type:'Demon',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.3,description:'-30% na perda de XP por penalidade'},lore:'"Onde pisava, a realidade quebrava. O Sistema confinou-o, mas o Monarca libertou-o."',icon:'lightning-bolt',color:'#ef4444',unlockMethod:{type:'shop',price:65e3}},{id:'shadow_monarch_herald',name:'Arauto do Monarca',rank:'Marshal',type:'Ancient',dropRate:0,passiveEffect:{type:'xp_boost',value:.3,description:'+30% XP em todas as miss\xf5es'},lore:'"A voz que anuncia o fim de todas as coisas. O seu sil\xeancio \xe9 a tua maior arma."',icon:'speaker-multiple',color:'#ef4444',unlockMethod:{type:'shop',price:75e3}},{id:'ancient_golem_prime',name:'Golem Ancestral Primordial',rank:'Marshal',type:'Tank',dropRate:0,passiveEffect:{type:'penalty_reduce',value:.4,description:'-40% na perda de XP por penalidade'},lore:'"A primeira montanha a ganhar vida. Inabal\xe1vel, imortal, absoluto."',icon:'image-filter-hdr',color:'#ef4444',unlockMethod:{type:'shop',price:8e4}}]},502,[]);
