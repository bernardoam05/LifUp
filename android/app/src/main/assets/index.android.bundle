focus',baseTarget:75,scalingAmount:0,scalingInterval:1,unit:'min',baseXP:1800,baseGold:820},{id:'boss_star_breaker',title:'Quebrador de Estrelas (S-Rank)',description:'Explora\xe7\xe3o documentada: percorre {target} km a p\xe9 num percurso nunca feito antes. Durante a marcha, identifica e regista (por escrito ou foto) pelo menos 3 elementos novos que nunca tinhas reparado.',type:'boss',questType:'gps',baseTarget:10,scalingAmount:0,scalingInterval:1,unit:'km',baseXP:1900,baseGold:880},{id:'boss_cold_philosopher',title:'O Fil\xf3sofo da Montanha (A-Rank)',description:'An\xe1lise de problema real: define um problema pessoal concreto que est\xe1s a adiar. Pesquisa contexto e opini\xf5es opostas durante {target} min (modo Foco ativo) e termina com uma decis\xe3o escrita.',type:'boss',questType:'focus',baseTarget:50,scalingAmount:0,scalingInterval:1,unit:'min',baseXP:760,baseGold:245},{id:'boss_digital_craftsman',title:'O Artes\xe3o Digital (A-Rank)',description:'Constr\xf3i algo digital do zero em {target} min: uma p\xe1gina web simples, um script \xfatil, uma apresenta\xe7\xe3o estruturada ou um prot\xf3tipo. O resultado tem de ser funcional ou apresent\xe1vel no final.',type:'boss',questType:'knowledge',baseTarget:90,scalingAmount:0,scalingInterval:1,unit:'min',baseXP:850,baseGold:280},{id:'boss_stoic_challenge',title:'A Prova do Estoico (A-Rank)',description:'Desconforto volunt\xe1rio: {target} min de treino f\xedsico num ambiente frio real (ao ar livre no frio, ou janelas abertas). Modo Foco ativo. Regista como te sentiste antes e depois.',type:'boss',questType:'focus',baseTarget:20,scalingAmount:0,scalingInterval:1,unit:'min',baseXP:700,baseGold:220}];var n=new Set(['alpha_wolf','sea_king','dungeon_queen','king_of_the_dead']);function l(o){return'boss'===o.type&&(!!o.id.startsWith('normal_boss_')||n.has(o.id))}},511,[1,7,497]);
