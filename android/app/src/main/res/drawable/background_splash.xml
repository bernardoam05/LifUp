<?xml version="1.0" encoding="utf-8"?>
<!--
  Native Splash Screen Background
  Layer 1: Solid black fill (#000000)
  Layer 2: The System circle (neon blue) centered on screen
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:opacity="opaque">

    <!-- Solid black background — fills the whole window -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>

    <!-- System circle logo centered — 200dp × 200dp -->
    <item
        android:width="200dp"
        android:height="200dp"
        android:gravity="center">
        <layer-list>

            <!-- Outer neon glow ring 1 -->
            <item>
                <shape android:shape="oval">
                    <stroke android:width="6dp" android:color="#3300BFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Outer neon glow ring 2 -->
            <item
                android:bottom="12dp"
                android:left="12dp"
                android:right="12dp"
                android:top="12dp">
                <shape android:shape="oval">
                    <stroke android:width="4dp" android:color="#6600CFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Main bright neon ring -->
            <item
                android:bottom="24dp"
                android:left="24dp"
                android:right="24dp"
                android:top="24dp">
                <shape android:shape="oval">
                    <stroke android:width="3dp" android:color="#FF00CFFF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Inner accent ring -->
            <item
                android:bottom="44dp"
                android:left="44dp"
                android:right="44dp"
                android:top="44dp">
                <shape android:shape="oval">
                    <stroke android:width="2dp" android:color="#CC00E5FF" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>

            <!-- Center glowing dot -->
            <item
                android:bottom="88dp"
                android:left="88dp"
                android:right="88dp"
                android:top="88dp">
                <shape android:shape="oval">
                    <solid android:color="#FF00E5FF" />
                </shape>
            </item>

        </layer-list>
    </item>

</layer-list>
