<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: the save and its daily copies go to the cloud backup and to a new phone. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="state.json" />
        <include domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="state.json" />
        <include domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
