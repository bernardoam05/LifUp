<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash from a fixed picture: it gets none, only the colour, and the app then
         shows the player's own Core (form, skin and accessory) for a moment (ui/Splash). -->
    <style name="Theme.LifUp.Launch">
        <item name="android:windowBackground">@drawable/background_splash</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
